{
  "name": "@interviewflowai/talking-avatar",
  "version": "0.1.2",
  "description": "Talking avatars for voice agents, by InterviewFlowAI: real-time lip sync for 3D avatars in the browser, and photoreal live avatars streamed to your page. MIT licensed.",
  "license": "MIT",
  "author": "InterviewFlowAI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interviewflowai/talking-avatar.git"
  },
  "bugs": {
    "url": "https://github.com/interviewflowai/talking-avatar/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./viseme-model.bin": "./dist/viseme-model.bin"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "lipsync",
    "lip-sync",
    "viseme",
    "avatar",
    "three",
    "webaudio",
    "tts",
    "talking-head",
    "live-avatar",
    "photoreal",
    "webrtc",
    "voice-agent"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && tsc -p tsconfig.build.json && cp model/viseme-model.bin dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/three": "^0.186.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.9"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://talking-avatar.dev"
}
